APP_NAME=DermaSoul AI
APP_VERSION=1.0.0
ENVIRONMENT=development

DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/dermasoul_ai

JWT_SECRET_KEY=use-a-long-random-string-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# localhost vs 127.0.0.1 differ; include both. Add 5174 if Vite falls back when 5173 is busy.
BACKEND_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174

UPLOAD_DIR=app/uploads
MAX_IMAGE_SIZE_MB=10
MAX_REPORT_SIZE_MB=15

# Same host/port as: python -m uvicorn app.main:app --reload --host 127.0.0.1 --port 8010
PUBLIC_BASE_URL=http://127.0.0.1:8010

DIAGNOSIS_MODEL_PATH=app/ml/ml_models/diagnosis_model_optimized.pth
SKIN_TYPE_MODEL_PATH=app/ml/ml_models/skin_type_model.pth

SMTP_ENABLED=false

# Hugging Face: models/cache live under backend/.hf-cache by default (first request downloads once).
# HF_CACHE_DIR=E:/full/path/to/persistent_hf_cache

# Offline after first successful download (local testing; leave false in prod until cache is warmed).
NLP_HF_HUB_OFFLINE=false

# Preload NER at startup so the first diagnose call is not slower.
NLP_ENTITY_WARMUP_ON_START=false
